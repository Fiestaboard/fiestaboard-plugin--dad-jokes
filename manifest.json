{
  "id": "dad_jokes",
  "name": "Dad Jokes",
  "version": "1.1.1",
  "description": "Display random dad jokes from the icanhazdadjoke API",
  "author": "FiestaBoard Team",
  "repository": "https://github.com/Fiestaboard/fiestaboard-plugin--dad-jokes",
  "documentation": "README.md",
  "icon": "laugh",
  "category": "entertainment",
  "min_refresh_seconds": 30,
  "settings_schema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "title": "Enable Dad Jokes",
        "default": false
      },
      "refresh_seconds": {
        "type": "integer",
        "title": "Refresh Interval (seconds)",
        "description": "How often to fetch a new dad joke",
        "default": 300,
        "minimum": 30,
        "maximum": 3600
      }
    }
  },
  "env_vars": [
    {
      "name": "DAD_JOKES_ENABLED",
      "required": false,
      "description": "Enable dad jokes feature",
      "default": "false"
    }
  ],
  "variables": {
    "groups": {
      "main": {
        "label": "Joke"
      }
    },
    "simple": {
      "joke": {
        "description": "The full dad joke text",
        "type": "string",
        "max_length": 120,
        "group": "main",
        "example": "Why don't skeletons fight? They don't have the guts."
      }
    }
  },
  "fiestaboard_version": ">=2.10.0",
  "screenshots": [
    {
      "src": "docs/board-display.png",
      "alt": "Dad Jokes displayed on a Vestaboard",
      "caption": "Display random dad jokes from the icanhazdadjoke API",
      "primary": true
    }
  ],
  "demo": {
    "flagship": {
      "name": "Dad Jokes Demo",
      "template": [
        "",
        "",
        "{{dad_jokes.joke}}",
        "",
        "",
        ""
      ],
      "line_metadata": [
        {
          "alignment": "center",
          "wrap": false
        },
        {
          "alignment": "center",
          "wrap": false
        },
        {
          "alignment": "center",
          "wrap": true
        },
        {
          "alignment": "center",
          "wrap": false
        },
        {
          "alignment": "center",
          "wrap": false
        },
        {
          "alignment": "center",
          "wrap": false
        }
      ]
    },
    "note": {
      "name": "Dad Jokes (Note)",
      "template": [
        "DAD JOKES",
        "{{dad_jokes.joke}}",
        ""
      ],
      "line_metadata": [
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": true
        },
        {
          "alignment": "left",
          "wrap": false
        }
      ]
    }
  }
}
